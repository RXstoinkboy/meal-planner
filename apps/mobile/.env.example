# Backend API base URL. For physical devices use your machine's LAN IP, e.g. http://192.168.1.x:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# PostHog (public project write key, see https://eu.posthog.com/project/settings or US equivalent).
# Leave unset to disable tracking entirely (facade becomes a no-op).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
