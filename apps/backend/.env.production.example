# Production secrets for `docker-compose.prod.yml`. Copy to `.env.production`
# (gitignored) and fill in. Never committed, never baked into an image.
NODE_ENV=production
TZ=UTC

# Traefik routes by this Host. Real domain, or the server IP until one exists.
# With ACME_EMAIL set, Traefik gets a Let's Encrypt cert for DOMAIN (real domain
# required — LE cannot issue for an IP) and bounces :80 to HTTPS. Empty = plain
# HTTP on PROXY_HTTP_PORT.
DOMAIN=
ACME_EMAIL=
# Publish ports: something else may own 80/443 (another web server on the VPS).
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Postgres. DATABASE_URL is derived by compose as
# postgresql://<DB_USER>:<DB_PASSWORD>@db:5432/<DB_DATABASE>?schema=public
# Set DATABASE_URL explicitly only to point api + migrate at a managed database.
DB_USER=meal_planner
DB_PASSWORD=
DB_DATABASE=meal_planner

# JWT signing (HS256). Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# CORS allowlist, comma separated. Empty reflects no origin in production.
CORS_ORIGIN=

# Rate limiting, per IP.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# PostHog (optional — analytics no-ops when unset)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error monitoring (optional — disabled when unset).
SENTRY_DSN=
SENTRY_RELEASE=
