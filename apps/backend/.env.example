# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=meal_planner
DB_PASSWORD=meal_planner
DB_DATABASE=meal_planner

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# PostHog (optional — analytics no-ops when unset)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error monitoring (optional — disabled when unset). SENTRY_RELEASE is
# set by the deploy platform to the commit SHA; leave unset locally.
SENTRY_DSN=
SENTRY_RELEASE=
