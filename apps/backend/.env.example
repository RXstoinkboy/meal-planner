# Node
TZ=UTC
NODE_ENV=development
PORT=3333
HOST=localhost
LOG_LEVEL=info

# PostgreSQL — Prisma uses DATABASE_URL, compose uses the DB_* pieces below.
# They must point at the same database. `npm run db` starts the container and
# also creates `<DB_DATABASE>_test` for the test suite.
DATABASE_URL=postgresql://meal_planner:meal_planner@localhost:5433/meal_planner?schema=public
DB_PORT=5433
DB_USER=meal_planner
DB_PASSWORD=meal_planner
DB_DATABASE=meal_planner

# CORS allowlist, comma separated. Empty = reflect any origin (development).
CORS_ORIGIN=

# Rate limiting, per IP.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# PostHog (optional — analytics no-ops when unset)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error monitoring (optional — disabled when unset). SENTRY_RELEASE is
# set by the deploy platform to the commit SHA; leave unset locally.
SENTRY_DSN=
SENTRY_RELEASE=
