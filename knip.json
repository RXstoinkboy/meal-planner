{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "semgrep"
  ],
  "workspaces": {
    "apps/backend": {
      "entry": [
        "src/main.ts",
        "src/app.module.ts",
        "scripts/*.ts",
        "test/**/*.ts",
        "prisma7.config.ts"
      ],
      "ignoreDependencies": [
        "@prisma/client",
        "pg",
        "pino-pretty"
      ]
    },
    "apps/mobile": {
      "entry": [
        "app/**/*.tsx",
        "tamagui.config.ts"
      ]
    }
  }
}
