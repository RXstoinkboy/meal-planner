{
  "name": "meal-planner",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "sast": "semgrep scan --config p/security-audit --config p/typescript --exclude node_modules --exclude .expo --exclude src/generated",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "^6.35.1",
    "turbo": "^2.10.12"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "@scarf/scarf@1.4.0": true,
    "@sentry/cli@2.58.4": true,
    "@swc/core@1.16.18": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@tamagui/core": "^3.1.2",
    "@tamagui/web": "^3.1.2",
    "tamagui": "^3.1.2"
  }
}
